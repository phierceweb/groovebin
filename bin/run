#!/usr/bin/env bash
# bin/run — invoke a command via the groovebin venv.
#
#   bin/run pytest [args]     run the test suite in the venv
#   bin/run python [args]     one-off venv'd python
#   bin/run pip|ruff [args]   pip / ruff in the venv
#   bin/run pw-doctor [args]  pw-foundation runtime attestation (--release before a tag); its wiring
#                             WARNs asking for pw-setup are expected on a clone; leave them
#   bin/run lint              ruff check + pw-foundation structural gate (300 soft / 500 hard)
#   bin/run pw-guards [args]  the structural gate alone
#   bin/run setup             install editable + link pw-foundation docs
#   bin/run pw-setup          maintainer only: pw-foundation's generic starter rules and editor links,
#                             which contradict groovebin's conventions in CONTRIBUTING.md
#   bin/run groovebin [args]  the CLI
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PY="$ROOT/.venv/bin/python"

# Local, uncommitted settings.
if [ -f "$ROOT/.env" ]; then set -a; . "$ROOT/.env"; set +a; fi

cmd="${1:-}"; shift || true
case "$cmd" in
  pytest|python|pip|ruff|pw-guards|pw-doctor|pw-setup)
    exec "$ROOT/.venv/bin/$cmd" "$@" ;;
  groovebin) exec "$PY" -m groovebin.cli "$@" ;;
  setup)
    [ -d "$ROOT/.venv" ] || python3.12 -m venv "$ROOT/.venv"
    "$PY" -m pip install -q --upgrade pip
    "$PY" -m pip install -q -e ".[dev]"
    mkdir -p docs
    ln -sfn "$("$PY" -c 'import pw_foundation, pathlib; print(pathlib.Path(pw_foundation.__file__).parent / "docs")')" \
       docs/pw-foundation
    echo "setup OK"
    ;;
  lint)
    "$ROOT/.venv/bin/ruff" check src tests
    "$PY" -m pw_foundation.guards          # roots come from .pw-guards.toml
    echo "lint OK"
    ;;
  ""|--help|-h) echo "usage: bin/run {setup|pytest|python|pip|ruff|lint|pw-guards|pw-doctor|pw-setup|groovebin} [args]" ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
